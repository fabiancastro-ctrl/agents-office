{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": ["daemon/**", "bin/**", "test/**", "hooks/**", "web/app/**", "web/robot-art.js"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "arrowParentheses": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "assist": { "enabled": false },
  "overrides": [
    {
      "includes": ["web/**"],
      "linter": { "rules": { "correctness": { "noUnusedVariables": "off" } } }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUndeclaredVariables": "off",
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      },
      "suspicious": {
        "noDoubleEquals": "warn",
        "noDebugger": "error"
      }
    }
  }
}
